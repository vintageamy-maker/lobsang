{
  // ─────────────────────────────────────────────────────────────
  // 開發站（lobsang.helwin.com.tw）專用設定。
  //
  // ⚠⚠ 這個檔案**只有在 ASPNETCORE_ENVIRONMENT=Stage 時才會被讀取**。
  //    compose 若寫 Production，改了這裡也不會生效（靜默失效，不會報錯）。
  //
  // ⚠⚠ **本檔進版控，因此不可放任何帳號密碼。**
  //    ConnectionStrings 與 Jwt:Key 一律留空，由環境變數注入。
  //
  // ⚠ ASP.NET Core 的設定優先序：環境變數 **蓋過** 設定檔。
  //    ⭐ 連線字串請用 `Uid=` / `Pwd=`（不是 `User Id=` / `Password=`）。
  // ─────────────────────────────────────────────────────────────
  "Logging": {
    "LogLevel": {
      // 開發站放寬到 Debug，正式站維持 Information —— 這是兩者刻意的差別。
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Key": "",
    "ExpireHours": "8"
  },
  "ErrorLog": {
    // 開發站留短一點就夠
    "RetentionDays": "30"
  },
  "Storage": {
    // ⚠⚠ **開發站必須用自己的 bucket**，不可與正式站共用 ——
    //    共用的話，開發時上傳或刪除的檔案會直接影響正式站。
    //    實際 bucket 名稱由 compose 的 Storage__Gcs__Bucket 覆寫。
    "Gcs": {
      "Bucket": ""
    }
  }
}
