{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // ⚠ 留空：由環境變數 ConnectionStrings__Default 注入（本檔進版控，不可放帳密）
    "Default": ""
  },
  "Jwt": {
    // ⚠ 留空：由環境變數 Jwt__Key 注入。每個站一把，不可共用
    "Key": "",
    "ExpireHours": "8"
  },
  "ErrorLog": {
    "RetentionDays": "90"
  },
  "Safety": {
    // ⭐ 有正式站之後填正式庫名稱：非 Production 環境連到它就拒絕啟動（防本機誤改正式庫）
    "ProductionDatabase": ""
  },
  "BookLookup": {
    // Google Books API 金鑰（選填）。⚠ 留空：由環境變數 BookLookup__GoogleApiKey 或 appsettings.Development.json 注入（本檔進版控）
    // 不填也能查，但共用 Google 的公用額度，常會「額度用完」
    "GoogleApiKey": ""
  }
}
