# ~/lobsang/.env 的範本。⚠ 真正的 .env 含帳密，不入版控（chmod 600）。
# ⭐ 連線字串用 Uid= / Pwd=（不是 User Id= / Password=）。
LOBSANG_CONN=Server=10.128.0.9;Port=3306;Database=Lobsang;Uid=web_adm;Pwd=（填入）;CharSet=utf8mb4;
# 每個站一把，不可與其他站共用。產生：openssl rand -base64 48
LOBSANG_JWT_KEY=
# 開發站登入頁的快速登入清單（JSON 陣列）。⚠ 正式站不設。
LOBSANG_DEMO_ACCOUNTS=[{"label":"👤 系統管理員","account":"admin","password":"（填入）"},{"label":"🧭 王主管","account":"manager01","password":"（填入）"},{"label":"🙂 陳同仁","account":"staff01","password":"（填入）"}]
# LINE（留空 ⇒ LINE 功能停用，其餘照常）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Login channel ID（留空 ⇒ 用 LIFF ID 的「-」前那段）
LINE_LOGIN_CHANNEL_ID=
LINE_LIFF_ID=
