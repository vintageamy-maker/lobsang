# ~/lobsang/.env 的範本。⚠ 真正的 .env 含帳密，不入版控（chmod 600）。
LOBSANG_CONN=Server=10.0.1.11;Port=3306;Database=Lobsang;Uid=web_adm;Pwd=（填入）;CharSet=utf8mb4;
# 每個站一把，不可與其他站共用。產生：openssl rand -base64 48
LOBSANG_JWT_KEY=
# LOBSANG_DEMO_ACCOUNTS 已移除（2026-11-08 業主：後台移除快速登入；它會把密碼公開在 /api/auth/demo-accounts）
GOOGLE_BOOKS_API_KEY=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LIFF_ID=
